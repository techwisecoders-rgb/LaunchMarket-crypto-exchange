# ============================================================
# SIDRA EXCHANGE — Backend Environment Template
# ============================================================
# Copy this file to `.env` and fill in your secrets:
#   cp .env.example .env
#
# ⚠️ NEVER commit a populated `.env` to source control.
# ============================================================


# ----------------------------------------------------------------
# Server
# ----------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=api
API_VERSION=v1
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001


# ----------------------------------------------------------------
# Database (Supabase PostgreSQL)
# ----------------------------------------------------------------
# Supabase's pooler (PgBouncer) is in transaction-pool mode, so
# Prisma must use the simple / unnamed-statement protocol.
#   pgbouncer=true      → forces unnamed prepared statements
#   connection_limit=1  → avoids "remaining connection slots" errors
#   schema=public       → skips SET search_path on every query
#
# Use the Supabase dashboard → Settings → Database → "Connection
# string" → "Transaction pooler" (port 6543) — that gives you the
# pooled URL. The DIRECT_URL only needs to be set if you plan to
# run `prisma migrate` against the direct IPv6-only hostname;
# otherwise point both vars at the pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=public
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1


# ----------------------------------------------------------------
# JWT
# ----------------------------------------------------------------
# Generate strong random hex strings (≥32 bytes) with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-64-char-hex
JWT_REFRESH_SECRET=replace-me-with-64-char-hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=sidra-exchange
JWT_AUDIENCE=sidra-exchange-api


# ----------------------------------------------------------------
# Encryption (AES-256-GCM) — 32-byte hex keys
# ----------------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=replace-me-with-64-char-hex
OTP_ENCRYPTION_KEY=replace-me-with-64-char-hex


# ----------------------------------------------------------------
# Email (Nodemailer / SMTP)
# ----------------------------------------------------------------
# Works with Resend, SendGrid, Mailgun, or Gmail App Passwords.
# Gmail: enable 2FA → create an App Password at
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password
SMTP_REJECT_UNAUTHORIZED=false
MAIL_FROM="SIDRA Exchange <no-reply@sidra.exchange>"
FRONTEND_URL=http://localhost:3000


# ----------------------------------------------------------------
# Blockchain — TESTNET (Sepolia / Base Sepolia)
# ----------------------------------------------------------------
# This deployment is pinned to TESTNET. The backend enforces
# this at runtime — mainnet chainIds (1, 8453) are REFUSED by the
# loadChainConfigs() safety guard in BlockchainService. Any chain
# row with a mainnet chainId is skipped with a loud error log.
NETWORK_TYPE=testnet

# ----------------------------------------------------------------
# RPC endpoints
# ----------------------------------------------------------------
# 🚨 FREE PUBLIC RPCs RATE-LIMIT AND DROP REQUESTS — this breaks
# the deposit poller. For production / demo use a DEDICATED
# provider with a generous free tier:
#
#   Alchemy   → https://www.alchemy.com/   (300M CU/mo free)
#   Infura    → https://www.infura.io/    (100k/day free)
#   QuickNode → https://www.quicknode.com/ (free tier available)
#
# Examples (replace YOUR_API_KEY with your actual key):
#
#   Alchemy:
#     ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
#     BASE_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY
#
#   Infura:
#     ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
#     BASE_RPC_URL=https://base-sepolia.infura.io/v3/YOUR_PROJECT_ID
#
# Fallback (only for local dev / quick testing — will rate-limit):
ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_RPC_URL=https://sepolia.base.org

# ----------------------------------------------------------------
# Chain IDs (testnet only)
# ----------------------------------------------------------------
ETHEREUM_CHAIN_ID=11155111        # Sepolia
BASE_CHAIN_ID=84532               # Base Sepolia

# ----------------------------------------------------------------
# Confirmations & polling
# ----------------------------------------------------------------
# Block confirmations required before a deposit is credited.
ETHEREUM_CONFIRMATIONS=3
BASE_CONFIRMATIONS=3

# How often (ms) the deposit poller scans each chain. If you are
# hitting a free-tier RPC rate limit, INCREASE this value
# (e.g. 120000 = 2 minutes, 300000 = 5 minutes).
ETHEREUM_POLLING_INTERVAL_MS=30000
BASE_POLLING_INTERVAL_MS=30000

# ----------------------------------------------------------------
# Explorers (used by the frontend "View on Explorer" links)
# ----------------------------------------------------------------
ETHEREUM_EXPLORER_URL=https://sepolia.etherscan.io
BASE_EXPLORER_URL=https://sepolia.basescan.org


# ----------------------------------------------------------------
# Rate Limiting (HTTP throttle)
# ----------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100


# ----------------------------------------------------------------
# Cookie / session
# ----------------------------------------------------------------
COOKIE_SECURE=false          # set to true behind HTTPS in production
COOKIE_SAME_SITE=lax


# ----------------------------------------------------------------
# CORS
# ----------------------------------------------------------------
# Comma-separated list of allowed origins. NO trailing slash.
CORS_ORIGINS=http://localhost:3000